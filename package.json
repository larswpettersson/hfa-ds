{
  "name": "hfa-ds",
  "version": "1.0.0",
  "private": true,
  "description": "HFA DS design tokens and Penpot sync tooling",
  "type": "module",
  "scripts": {
    "validate": "node scripts/build/validate-json.mjs",
    "build:penpot": "node scripts/build/embed-for-penpot.mjs",
    "build:css": "node scripts/codegen/tokens-to-css.mjs",
    "build": "npm run validate && npm run build:penpot && npm run build:css",
    "scan:secrets": "bash scripts/security/scan-secrets.sh",
    "test": "playwright test",
    "test:shared": "playwright test tests/shared",
    "test:stpa": "playwright test tests/stpa",
    "sync:ai-panel": "node scripts/ai-panel/sync.mjs",
    "check:ai-panel": "node scripts/ai-panel/sync.mjs --check",
    "build:offline": "node scripts/build/inline-offline.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
